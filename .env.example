# Local SQLite file (default). Use an absolute path on a persistent volume for Docker.
DATABASE_PATH=./data/districtcare.db
# Hosted Turso database (e.g. on Vercel). When set, DATABASE_PATH is ignored.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Public demo mode grants synthetic-data roles only. Never use with real data.
DEMO_MODE=true
# Optional shared administrator key when DEMO_MODE=false. Server-only.
ADMIN_KEY=
